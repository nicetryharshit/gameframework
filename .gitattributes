# Store LF in the repository. Windows launchers need CRLF; shell launchers need LF.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.command text eol=lf
*.sh text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.icns binary
*.ico binary
*.wav binary
*.mp3 binary
*.ogg binary
*.ttf binary
*.woff2 binary
*.wasm binary
*.zip binary
