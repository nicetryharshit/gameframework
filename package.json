{
  "name": "gameframework",
  "version": "0.2.0",
  "license": "MPL-2.0",
  "private": true,
  "bin": {
    "create-web-game": "./scripts/create-game.mjs",
    "game-export-ui": "./scripts/export-ui/server.mjs"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./src/framework/index.ts",
    "./pixi": "./src/renderers/pixi.ts",
    "./three": "./src/renderers/three.ts",
    "./canvas": "./src/renderers/canvas.ts",
    "./desktop": "./src/platform/desktop.ts",
    "./scene": "./src/scene/index.ts"
  },
  "files": [
    "src/framework",
    "src/renderers",
    "src/physics",
    "src/platform",
    "src/scene",
    "src-tauri/src",
    "src-tauri/icons",
    "src-tauri/capabilities",
    "src-tauri/Cargo.toml",
    "src-tauri/Cargo.lock",
    "src-tauri/build.rs",
    "src-tauri/tauri.conf.json",
    "scripts/create-game.mjs",
    "scripts/export-ui",
    "docs/UPGRADING.md",
    "docs/PLATFORM-BUILDS.md",
    "docs/SCENE.md",
    "docs/EXPORT-DASHBOARD.md",
    "docs/FRAMEWORK.md",
    "src/demo.ts",
    "src/demo-settings.ts",
    "src/flappy.ts",
    "src/demo.css",
    "src/demo-2d.ts",
    "src/demo-3d.ts",
    "src/demo-canvas.ts",
    "README.md"
  ],
  "peerDependencies": {
    "@tauri-apps/api": "^2.0.0",
    "pixi.js": "^8.22.0",
    "three": "^0.187.0"
  },
  "peerDependenciesMeta": {
    "@tauri-apps/api": {
      "optional": true
    },
    "pixi.js": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  },
  "scripts": {
    "dev": "vite",
    "create:game": "node scripts/create-game.mjs",
    "export:ui": "node scripts/export-ui/server.mjs",
    "workshop": "node scripts/export-ui/server.mjs --open",
    "doctor": "node scripts/doctor.mjs",
    "build": "tsc --noEmit && vite build",
    "build:web": "npm run build",
    "tauri": "tauri",
    "dev:desktop": "tauri dev",
    "build:desktop": "tauri build --no-sign",
    "init:android": "tauri android init",
    "dev:android": "tauri android dev",
    "open:android": "tauri android dev --open",
    "build:android": "tauri android build --debug --apk",
    "init:ios": "tauri ios init",
    "dev:ios": "tauri ios dev",
    "open:ios": "tauri ios dev --open",
    "build:ios": "tauri ios build",
    "test": "tsx --test tests/*.test.ts"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/cli": "^2.12.4",
    "@types/matter-js": "0.20.2",
    "@types/node": "^24.0.0",
    "@types/three": "^0.187.0",
    "happy-dom": "^21.0.4",
    "matter-js": "0.20.0",
    "pixi.js": "^8.22.0",
    "planck": "1.5.1",
    "three": "^0.187.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
