{
  "name": "web-game-framework",
  "version": "0.1.0",
  "private": true,
  "bin": { "create-web-game": "./scripts/create-game.mjs" },
  "type": "module",
  "exports": {
    ".": "./src/framework/index.ts",
    "./pixi": "./src/renderers/pixi.ts",
    "./three": "./src/renderers/three.ts"
  },
  "files": [
    "src/framework",
    "src/renderers",
    "src-tauri",
    "scripts/create-game.mjs",
    "src/demo.ts",
    "src/demo.css",
    "src/demo-2d.ts",
    "src/demo-3d.ts",
    "README.md"
  ],
  "peerDependencies": {
    "pixi.js": "^8.22.0",
    "three": "^0.187.0"
  },
  "peerDependenciesMeta": {
    "pixi.js": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  },
  "scripts": {
    "dev": "vite",
    "create:game": "node scripts/create-game.mjs",
    "benchmark": "tsx scripts/benchmark.ts",
    "build": "tsc --noEmit && vite build",
    "build:web": "npm run build",
    "tauri": "tauri",
    "dev:desktop": "tauri dev",
    "build:desktop": "tauri build --no-sign",
    "init:android": "tauri android init",
    "dev:android": "tauri android dev",
    "build:android": "tauri android build --debug --apk",
    "init:ios": "tauri ios init",
    "dev:ios": "tauri ios dev",
    "build:ios": "tauri ios build",
    "test": "tsx --test tests/*.test.ts"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.0.0",
    "@types/three": "^0.187.0",
    "pixi.js": "^8.22.0",
    "three": "^0.187.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
